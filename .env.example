# Server (Render) — never commit real secrets
PORT=8787
NODE_ENV=development

RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
RAZORPAY_WEBHOOK_SECRET=

# Shared secret your apps send as header: X-Checkout-Key
# Leave empty to allow open access (OK for local demo only)
CHECKOUT_API_KEY=change-me-to-a-long-random-string

# Comma-separated browser origins allowed to call this API
# Must include every frontend that calls checkout (app subdomain + apex + local)
CORS_ORIGINS=https://app.viewmyjson.com,https://viewmyjson.com,https://www.viewmyjson.com,https://json-ui-viewer.vercel.app,http://localhost:5173,http://127.0.0.1:5173

# Optional business display name shown in Checkout
BUSINESS_NAME=My App

# Plans JSON — amounts are ALWAYS taken from here (safe). Clients only send planId.
# amountMinorUnits = major currency units * 100 (e.g. USD cents)
PLANS_JSON={"proMonth":{"title":"Monthly","amountMinorUnits":500,"currency":"USD"},"proYear":{"title":"Yearly","amountMinorUnits":1000,"currency":"USD"},"removeAds":{"title":"Lifetime","amountMinorUnits":2000,"currency":"USD"}}
PLANS_INR_JSON={"proMonth":{"title":"Monthly","amountMinorUnits":9900,"currency":"INR"},"proYear":{"title":"Yearly","amountMinorUnits":49900,"currency":"INR"},"removeAds":{"title":"Lifetime","amountMinorUnits":99900,"currency":"INR"}}

# true = simulate orders without calling Razorpay (local UI testing)
DEMO_PAYMENTS=false
